# Copia este archivo a ".env" y llena los valores reales.
# NUNCA subas el ".env" real a GitHub -- agrega ".env" a tu .gitignore.

ETL_EMPRESAS=cfs,acabados

# --- Oracle: Comercializadora y Ferreteria Shuma (CFS) ---
# (usuario de SOLO LECTURA, ver sql/01_oracle_readonly_user.sql)
ORACLE_CFS_USER=ETL_DASHBOARD
ORACLE_CFS_PASSWORD=CAMBIA_ESTE_PASSWORD_123!
# Formato: host:puerto/service_name  (ajusta a tu conexion real de SGE_CFS_PROD)
ORACLE_CFS_DSN=192.168.1.xxx:1521/SGE_CFS_PROD

# --- Oracle: Acabados Shuma ---
ORACLE_ACABADOS_USER=ETL_DASHBOARD
ORACLE_ACABADOS_PASSWORD=CAMBIA_ESTE_PASSWORD_456!
ORACLE_ACABADOS_DSN=192.168.2.xxx:1521/SGE_ACABADOS_PROD

# --- Oracle Instant Client (OBLIGATORIO con Oracle 11g) ---
# La base corre sobre Oracle 11.2. El modo "thin" de python-oracledb solo
# funciona con 12.1 o superior, asi que hace falta el Instant Client 19c.
# Las versiones 21c y 23ai NO sirven: ya no soportan bases 11.2.
#
# Descarga (Basic Light, ~35 MB):
#   https://www.oracle.com/database/technologies/instant-client/downloads.html
#
# Apunta a la carpeta descomprimida:
#   Windows: C:\oracle\instantclient_19_28
#   Linux:   /opt/oracle/instantclient_19_28
#
# En Docker ya viene configurada, no hace falta ponerla aqui.
ORACLE_CLIENT_DIR=C:\oracle\instantclient_19_28

# --- Supabase (Service Role Key -- NUNCA la uses en el frontend) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui

# --- Opcional: configuracion del calculo ---
# ETL_FECHA_INICIO=2025-01-01
# ETL_DIAS_DORMANCIA=30
